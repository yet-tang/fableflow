{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fableflow.local/schemas/concept-sheet.schema.json",
  "title": "FableFlow Concept Sheet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "episode_id", "concept_name", "plain_definition", "necessary_conditions",
    "causal_chain", "perspectives", "real_world_examples", "counterexamples",
    "common_misunderstandings", "metaphor_ingredients", "simplification_policy",
    "accuracy_risk"
  ],
  "properties": {
    "episode_id": {"type": "string", "pattern": "^EP[0-9]{3,}$"},
    "concept_name": {"type": "string", "minLength": 1},
    "plain_definition": {"type": "string", "minLength": 20},
    "necessary_conditions": {"type": "array", "minItems": 2, "items": {"type": "string"}},
    "causal_chain": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step", "cause", "effect"],
        "properties": {
          "step": {"type": "integer", "minimum": 1},
          "cause": {"type": "string"},
          "effect": {"type": "string"}
        }
      }
    },
    "perspectives": {
      "type": "object",
      "additionalProperties": false,
      "required": ["individual", "system", "long_term"],
      "properties": {
        "individual": {"type": "string"},
        "system": {"type": "string"},
        "long_term": {"type": "string"}
      }
    },
    "real_world_examples": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "explanation", "daily_life"],
        "properties": {
          "name": {"type": "string"},
          "explanation": {"type": "string"},
          "daily_life": {"type": "boolean"}
        }
      }
    },
    "counterexamples": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "common_misunderstandings": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "metaphor_ingredients": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objects", "rules", "incentives", "conflicts", "outcomes"],
      "properties": {
        "objects": {"type": "array", "items": {"type": "string"}},
        "rules": {"type": "array", "items": {"type": "string"}},
        "incentives": {"type": "array", "items": {"type": "string"}},
        "conflicts": {"type": "array", "items": {"type": "string"}},
        "outcomes": {"type": "array", "items": {"type": "string"}}
      }
    },
    "simplification_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["may_omit", "must_keep"],
      "properties": {
        "may_omit": {"type": "array", "items": {"type": "string"}},
        "must_keep": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "accuracy_risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "review_notes"],
      "properties": {
        "level": {"enum": ["low", "medium", "high"]},
        "review_notes": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
