{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fableflow.local/schemas/storyboard.schema.json",
  "title": "FableFlow Storyboard",
  "type": "object",
  "additionalProperties": false,
  "required": ["episode_id", "aspect_ratio", "total_duration_sec", "shots"],
  "properties": {
    "episode_id": {"type": "string", "pattern": "^EP[0-9]{3,}$"},
    "aspect_ratio": {"const": "9:16"},
    "total_duration_sec": {"type": "number", "minimum": 45, "maximum": 180},
    "shots": {
      "type": "array",
      "minItems": 8,
      "maxItems": 18,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "shot_id", "start_sec", "end_sec", "duration_sec", "section_role", "shot_size",
          "composition", "characters", "visible_action", "environment", "emotion", "voiceover",
          "subtitle", "camera_motion", "transition", "sound", "safe_area", "continuity",
          "asset_strategy"
        ],
        "properties": {
          "shot_id": {"type": "string", "pattern": "^S[0-9]{2}$"},
          "start_sec": {"type": "number", "minimum": 0},
          "end_sec": {"type": "number", "exclusiveMinimum": 0},
          "duration_sec": {"type": "number", "minimum": 1, "maximum": 15},
          "section_role": {"enum": ["hook", "setup", "escalation", "guess", "reveal", "explanation", "ending"]},
          "shot_size": {"enum": ["extreme_wide", "wide", "medium_wide", "medium", "medium_close", "close", "insert", "title_card"]},
          "composition": {"type": "string"},
          "characters": {"type": "array", "items": {"type": "string"}},
          "visible_action": {"type": "string"},
          "environment": {"type": "string"},
          "emotion": {"type": "string"},
          "voiceover": {"type": "string"},
          "subtitle": {"type": "string"},
          "camera_motion": {"type": "string"},
          "transition": {"type": "string"},
          "sound": {"type": "string"},
          "safe_area": {"type": "string"},
          "continuity": {"type": "string"},
          "asset_strategy": {"enum": ["generate", "reuse", "title_card"]}
        }
      }
    }
  }
}
