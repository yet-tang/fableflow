{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fableflow.local/schemas/story-options.schema.json",
  "title": "FableFlow Story Options",
  "type": "object",
  "additionalProperties": false,
  "required": ["episode_id", "options"],
  "properties": {
    "episode_id": {"type": "string", "pattern": "^EP[0-9]{3,}$"},
    "options": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "option_id", "working_title", "hook", "setting", "protagonist_goal",
          "world_rule", "beats", "guess_clues", "metaphor_map", "misinterpretation_risks",
          "visual_plan", "scores", "total_score"
        ],
        "properties": {
          "option_id": {"type": "string", "pattern": "^O[1-3]$"},
          "working_title": {"type": "string"},
          "hook": {"type": "string", "minLength": 10},
          "setting": {"type": "string"},
          "protagonist_goal": {"type": "string"},
          "world_rule": {"type": "string"},
          "beats": {"type": "array", "minItems": 5, "maxItems": 7, "items": {"type": "string"}},
          "guess_clues": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "metaphor_map": {
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["story_element", "concept_element"],
              "properties": {
                "story_element": {"type": "string"},
                "concept_element": {"type": "string"}
              }
            }
          },
          "misinterpretation_risks": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["risk", "mitigation"],
              "properties": {
                "risk": {"type": "string"},
                "mitigation": {"type": "string"}
              }
            }
          },
          "visual_plan": {
            "type": "object",
            "additionalProperties": false,
            "required": ["estimated_shots", "difficulty", "new_assets"],
            "properties": {
              "estimated_shots": {"type": "integer", "minimum": 8, "maximum": 18},
              "difficulty": {"enum": ["low", "medium", "high"]},
              "new_assets": {"type": "array", "items": {"type": "string"}}
            }
          },
          "scores": {
            "type": "object",
            "additionalProperties": false,
            "required": ["mechanism", "story", "hook", "delayed_reveal", "visual", "transfer"],
            "properties": {
              "mechanism": {"type": "integer", "minimum": 1, "maximum": 5},
              "story": {"type": "integer", "minimum": 1, "maximum": 5},
              "hook": {"type": "integer", "minimum": 1, "maximum": 5},
              "delayed_reveal": {"type": "integer", "minimum": 1, "maximum": 5},
              "visual": {"type": "integer", "minimum": 1, "maximum": 5},
              "transfer": {"type": "integer", "minimum": 1, "maximum": 5}
            }
          },
          "total_score": {"type": "integer", "minimum": 6, "maximum": 30}
        }
      }
    }
  }
}
