{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fableflow.local/schemas/episode-brief.schema.json",
  "title": "FableFlow Episode Brief",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "episode_id", "slug", "concept_name", "domain", "target_audience",
    "target_duration_sec", "learning_goal", "why_now", "content_risk",
    "prompt_versions", "status"
  ],
  "properties": {
    "episode_id": {"type": "string", "pattern": "^EP[0-9]{3,}$"},
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "concept_name": {"type": "string", "minLength": 1},
    "domain": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "target_audience": {"type": "string", "minLength": 1},
    "target_duration_sec": {"type": "integer", "minimum": 45, "maximum": 180},
    "learning_goal": {"type": "string", "minLength": 20},
    "why_now": {"type": "string", "minLength": 10},
    "real_life_entry_points": {"type": "array", "items": {"type": "string"}},
    "content_risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "notes"],
      "properties": {
        "level": {"enum": ["low", "medium", "high"]},
        "notes": {"type": "string"}
      }
    },
    "prompt_versions": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "status": {
      "enum": ["draft", "g1_approved", "in_production", "g4_approved", "published", "measured"]
    }
  }
}
