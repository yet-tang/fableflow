{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fableflow.local/schemas/video-manifest.schema.json",
  "title": "FableFlow Seedance Video Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["episode_id", "provider", "model", "default_audio_policy", "clips"],
  "properties": {
    "episode_id": {"type": "string", "pattern": "^EP[0-9]{3,}$"},
    "provider": {"const": "seedance"},
    "model": {"type": "string", "minLength": 1},
    "default_audio_policy": {"enum": ["silent", "ambience_only", "keep_if_usable"]},
    "clips": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "clip_id", "filename", "shot_ids", "mode", "timeline_duration_sec",
          "requested_duration_sec", "reference_assets", "reference_videos", "reference_audio",
          "initial_state", "primary_action", "camera_motion", "prompt", "audio_mode",
          "continuity_constraints", "negative_constraints", "edit_instruction",
          "review_checks", "fallback", "status"
        ],
        "properties": {
          "clip_id": {"type": "string", "pattern": "^V[0-9]{2}$"},
          "filename": {"type": "string"},
          "shot_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^S[0-9]{2}$"}},
          "mode": {"enum": ["image_to_video", "text_to_video", "multimodal_reference", "reuse_clip", "edit_only"]},
          "timeline_duration_sec": {"type": "number", "minimum": 1, "maximum": 30},
          "requested_duration_sec": {"type": "number", "minimum": 0, "maximum": 20},
          "reference_assets": {"type": "array", "items": {"type": "string"}},
          "reference_videos": {"type": "array", "items": {"type": "string"}},
          "reference_audio": {"type": "array", "items": {"type": "string"}},
          "initial_state": {"type": "string"},
          "primary_action": {"type": "string"},
          "camera_motion": {"type": "string"},
          "prompt": {"type": "string"},
          "audio_mode": {"enum": ["silent", "ambience_only", "keep_if_usable", "not_applicable"]},
          "continuity_constraints": {"type": "array", "items": {"type": "string"}},
          "negative_constraints": {"type": "array", "items": {"type": "string"}},
          "edit_instruction": {"type": "string"},
          "review_checks": {"type": "array", "minItems": 3, "items": {"type": "string"}},
          "fallback": {"type": "string"},
          "status": {"enum": ["planned", "generating", "generated", "approved", "regenerate", "fallback_still", "not_applicable"]}
        }
      }
    }
  }
}
